# ==============================================================================
# REAL-TIME FULL-DUPLEX VIETNAMESE VOICEBOT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
LOG_LEVEL=INFO

# n8n Webhook Integration (Logic & LLM / RAG Brain)
# Target webhook URL handling {"session_id": "...", "text": "..."}
N8N_WEBHOOK_URL=http://localhost:5678/webhook/voicebot
N8N_TIMEOUT_SECONDS=15.0

# Speech-to-Text (STT) Engines
# 1. Groq Cloud API (Optional - Siêu tốc ~0.2s bằng Whisper Large V3)
# Đăng ký miễn phí tại https://console.groq.com để lấy API key
GROQ_API_KEY=

# 2. Local Whisper Engine (faster-whisper)
# Models: mad1999/pho-whisper-small-ct2 (Khuyên dùng cho tiếng Việt), small, base, tiny
WHISPER_MODEL_SIZE=mad1999/pho-whisper-small-ct2
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Text-to-Speech (TTS) Microsoft Azure Neural Voices
# Voices: vi-VN-HoaiMyNeural (Nữ miền Bắc), vi-VN-NamMinhNeural (Nam miền Bắc)
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# Voice Activity Detection (Silero VAD) Tuning
VAD_CONFIDENCE_THRESHOLD=0.5
VAD_SILENCE_DURATION_MS=700
VAD_MIN_SPEECH_DURATION_MS=250
